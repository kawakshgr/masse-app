      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de liens demandés. Supabase limite les envois à quelques-uns par heure tant qu’aucun SMTP n’est configuré. Attends une heure, ou branche un vrai service d’e-mail."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many links requested. Supabase caps sends to a few per hour until you configure SMTP. Wait an hour, or connect a real email service."
          }
        }
      }
    },
