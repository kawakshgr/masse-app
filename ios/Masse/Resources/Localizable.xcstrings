    "onboarding.cycleLede": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionnel, et révocable à tout moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional, and revocable at any time."
          }
        }
      }
    },
    "onboarding.cyclePromise": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu l’actives, seules ta date de règles et la durée de ton cycle sont enregistrées — en Europe. Tes notes de symptômes ne quittent jamais ton téléphone : il n’existe aucune table pour les stocker. Ton coach voit une phase et une charge adaptée, jamais un symptôme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn it on, only your period start date and cycle length are stored — in Europe. Your symptom notes never leave your phone: there is no table to hold them. Your coach sees a phase and an adapted load, never a symptom."
          }
        }
      }
    },
    "onboarding.cycleOn": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
