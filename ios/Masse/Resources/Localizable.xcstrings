          "stringUnit": {
            "state": "translated",
            "value": "No connection"
          }
        }
      }
    },
    "offline.lede": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masse a besoin du réseau pour charger tes séances."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masse needs the network to load your sessions."
          }
        }
      }
    },
    "offline.held": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes séries saisies hors-ligne sont gardées sur cet appareil. Elles partiront dès que la connexion revient — tu n’as rien à faire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets you logged offline are kept on this device. They go as soon as the connection returns — you have nothing to do."
          }
        }
      }
    },
    "offline.retry": {
      "extractionState": "manual",
      "localizations": {
