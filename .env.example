# Copier vers .env.local et remplir depuis le tableau de bord Supabase.
# Settings → API. La clé publishable est sûre côté client : RLS fait le travail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Envoi des factures par e-mail. Facultatif : sans ces deux variables, le bouton
# « Envoyer par e-mail » n'apparaît pas et le coach télécharge le PDF pour le
# joindre lui-même. Masse ne prétend jamais avoir envoyé quelque chose.
#   RESEND_API_KEY      : clé API Resend (resend.com)
#   INVOICE_FROM_EMAIL  : expéditeur, sur un domaine vérifié chez Resend
#   INVOICE_REPLY_TO    : facultatif — l'adresse à laquelle le client répond
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
INVOICE_REPLY_TO=
