# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — these carry the Supabase keys. Never commit them.
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase — local stack state and linked-project secrets
/supabase/.branches
/supabase/.temp
/supabase/.env

# ios — Xcode's per-user state and build output. Package.resolved IS committed:
# it is what makes two machines resolve the same dependency versions.
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/DerivedData/
ios/.swiftpm/
*.xcscmblueprint
